<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>عروض الفرقة | تياترو الصعيد</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>

:root{
    --accent:#2bb3b1;
    --accent-light:#8ce5df;
    --black:#080909;
    --dark:#111314;
    --dark2:#17191a;
    --white:#ffffff;
    --muted:#9da5a7;
    --line:rgba(255,255,255,.10);
}

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:'Cairo',sans-serif;
    background:#090a0a;
    color:#fff;
    line-height:1.8;
    overflow-x:hidden;
}

body.en{
    font-family:'Inter',sans-serif;
    direction:ltr;
}

a{
    text-decoration:none;
    color:inherit;
}

.ar{
    display:block;
}

.en{
    display:none!important;
}

body.en .ar{
    display:none!important;
}

body.en .en{
    display:block!important;
}


/* =========================
   NAVBAR
========================= */

.navbar{
    height:78px;
    position:fixed;
    top:0;
    left:0;
    right:0;
    z-index:1000;

    display:flex;
    align-items:center;
    justify-content:space-between;

    padding:0 5%;

    background:rgba(255,255,255,.96);
    backdrop-filter:blur(15px);

    border-bottom:1px solid rgba(0,0,0,.08);
}

.logo{
    height:50px;
    width:auto;
    object-fit:contain;
}

.nav-links{
    display:flex;
    align-items:center;
    gap:25px;

    font-size:14px;
    font-weight:600;
}

.nav-links a{
    position:relative;
    white-space:nowrap;
    color:#111;
}

.nav-links a::after{
    content:"";
    position:absolute;
    right:0;
    bottom:-7px;

    width:0;
    height:2px;

    background:var(--accent);

    transition:.3s;
}

.nav-links a:hover::after{
    width:100%;
}

.lang-btn{
    border:1px solid #ccc;
    background:#fff;
    color:#111;

    border-radius:30px;

    padding:7px 14px;

    cursor:pointer;

    font-family:inherit;
    font-weight:800;

    transition:.3s;
}

.lang-btn:hover{
    border-color:var(--accent);
    color:var(--accent);
}

.menu-btn{
    display:none;

    border:0;
    background:none;

    color:#111;

    font-size:28px;

    cursor:pointer;
}


/* =========================
   HERO
========================= */

.hero{
    margin-top:78px;

    min-height:72vh;

    position:relative;

    display:flex;
    align-items:flex-end;

    overflow:hidden;

    background:#080909;
}

.hero-bg{
    position:absolute;
    inset:0;

    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,.82),
            rgba(0,0,0,.25)
        ),
        url('images/troupe.jpg') center/cover no-repeat;

    filter:saturate(.75);

    transform:scale(1.03);
}

.hero::after{
    content:"";

    position:absolute;
    inset:0;

    background:
        linear-gradient(
            0deg,
            #090a0a 0%,
            transparent 55%
        );
}

.hero-content{
    position:relative;
    z-index:2;

    width:100%;
    max-width:1250px;

    margin:auto;

    padding:90px 5% 80px;
}

.eyebrow{
    display:inline-flex;
    align-items:center;

    gap:10px;

    color:var(--accent-light);

    font-size:12px;
    font-weight:800;

    letter-spacing:2px;

    margin-bottom:18px;
}

.eyebrow::before{
    content:"";

    width:35px;
    height:2px;

    background:var(--accent);
}

.hero h1{
    max-width:900px;

    font-size:clamp(45px,7vw,88px);

    line-height:1.08;

    font-weight:900;

    letter-spacing:-2px;
}

.hero p{
    max-width:720px;

    margin-top:22px;

    color:#d3d7d8;

    font-size:17px;

    line-height:2;
}

.hero-stats{
    display:flex;

    gap:40px;

    margin-top:35px;

    flex-wrap:wrap;
}

.hero-stat strong{
    display:block;

    font-size:34px;

    color:#fff;
}

.hero-stat span{
    color:#9fa5a7;

    font-size:12px;
}


/* =========================
   PRODUCTIONS
========================= */

.productions-section{
    position:relative;

    padding:80px 5% 110px;

    background:#090a0a;
}

.productions-section::before{
    content:"";

    position:absolute;

    left:-10%;
    top:10%;

    width:420px;
    height:420px;

    background:rgba(43,179,177,.06);

    filter:blur(80px);

    border-radius:50%;
}

.section-wrap{
    position:relative;

    max-width:1250px;

    margin:auto;
}

.section-head{
    display:flex;

    align-items:flex-end;
    justify-content:space-between;

    gap:25px;

    margin-bottom:32px;
}

.section-head h2{
    font-size:clamp(27px,3vw,38px);

    font-weight:900;
}

.section-head p{
    margin-top:5px;

    color:var(--muted);

    font-size:14px;
}

.counter{
    padding:9px 15px;

    border:1px solid var(--line);

    background:rgba(255,255,255,.04);

    border-radius:999px;

    color:#ddd;

    font-size:12px;

    white-space:nowrap;
}

.counter b{
    color:var(--accent);

    font-size:17px;
}


/* SEARCH */

.tools{
    display:flex;

    margin-bottom:32px;
}

.search{
    width:min(420px,100%);

    height:48px;

    padding:0 18px;

    border:1px solid var(--line);

    border-radius:4px;

    outline:none;

    background:#111415;

    color:#fff;

    font-family:inherit;

    font-size:13px;

    transition:.3s;
}

.search::placeholder{
    color:#777;
}

.search:focus{
    border-color:var(--accent);

    box-shadow:
        0 0 0 3px
        rgba(43,179,177,.08);
}


/* =========================
   CARDS
========================= */

.production-grid{
    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:24px;
}

.card{
    position:relative;

    overflow:hidden;

    background:#111314;

    border:1px solid rgba(255,255,255,.09);

    cursor:pointer;

    box-shadow:
        0 10px 35px
        rgba(0,0,0,.20);

    transition:.45s ease;
}

.card:hover{
    transform:translateY(-9px);

    border-color:
        rgba(43,179,177,.55);

    box-shadow:
        0 25px 55px
        rgba(0,0,0,.42);
}


/* POSTER */

.poster{
    position:relative;

    aspect-ratio:2/3;

    overflow:hidden;

    background:#171919;
}

.poster img{
    display:block;

    width:100%;
    height:100%;

    object-fit:cover;

    transition:
        transform .8s
        cubic-bezier(.2,.7,.2,1),
        filter .6s ease;
}

.card:hover .poster img{
    transform:scale(1.07);

    filter:brightness(.70);
}

.poster::after{
    content:"";

    position:absolute;
    inset:0;

    background:
        linear-gradient(
            180deg,
            rgba(0,0,0,.15),
            transparent 35%,
            rgba(0,0,0,.90)
        );

    pointer-events:none;
}


/* NUMBER */

.card-no{
    position:absolute;

    top:13px;
    right:13px;

    z-index:5;

    width:35px;
    height:35px;

    display:grid;
    place-items:center;

    border-radius:50%;

    background:rgba(5,5,5,.70);

    border:1px solid
        rgba(255,255,255,.25);

    color:#fff;

    font-family:Inter,sans-serif;

    font-size:11px;

    font-weight:700;
}


/* YEAR */

.year{
    position:absolute;

    top:14px;
    left:13px;

    z-index:5;

    padding:4px 9px;

    background:rgba(43,179,177,.90);

    color:#fff;

    font-family:Inter,sans-serif;

    font-size:10px;

    font-weight:800;

    letter-spacing:1px;
}


/* OVERLAY */

.poster-overlay{
    position:absolute;

    inset:0;

    z-index:4;

    display:flex;

    align-items:flex-end;

    padding:18px;

    opacity:0;

    transition:.4s;
}

.card:hover .poster-overlay{
    opacity:1;
}

.details-btn{
    display:inline-flex;

    align-items:center;

    gap:8px;

    padding:9px 14px;

    background:#fff;

    color:#0a0b0b;

    font-size:11px;

    font-weight:900;
}

.details-btn span:first-child{
    font-size:15px;
}


/* BODY */

.card-body{
    padding:17px 17px 19px;
}

.card h3{
    margin-bottom:8px;

    font-size:18px;

    line-height:1.45;

    font-weight:800;
}

.card-meta{
    display:flex;

    justify-content:space-between;

    align-items:center;

    gap:8px;

    color:#92999b;

    font-size:10px;

    font-weight:700;
}

.type{
    color:var(--accent);
}

.card-desc{
    margin-top:8px;

    color:#8f9698;

    font-size:12px;

    line-height:1.8;

    display:-webkit-box;

    -webkit-line-clamp:2;

    -webkit-box-orient:vertical;

    overflow:hidden;
}


/* =========================
   MODAL
========================= */

.modal{
    position:fixed;

    inset:0;

    z-index:3000;

    display:none;

    align-items:center;
    justify-content:center;

    padding:25px;

    background:rgba(0,0,0,.92);

    backdrop-filter:blur(12px);
}

.modal.open{
    display:flex;
}

.modal-box{
    position:relative;

    width:min(1100px,96vw);

    max-height:92vh;

    overflow:hidden;

    display:grid;

    grid-template-columns:46% 54%;

    background:#111314;

    border:1px solid
        rgba(255,255,255,.12);

    box-shadow:
        0 25px 70px
        rgba(0,0,0,.55);
}

.modal-img{
    min-height:600px;

    background:#050505;
}

.modal-img img{
    display:block;

    width:100%;
    height:100%;

    object-fit:contain;
}

.modal-content{
    display:flex;

    flex-direction:column;

    justify-content:center;

    padding:55px 48px;
}

.modal-kicker{
    margin-bottom:17px;

    color:var(--accent);

    font-family:Inter,sans-serif;

    font-size:10px;

    font-weight:800;

    letter-spacing:2px;
}

.modal-content h2{
    margin-bottom:20px;

    font-size:clamp(30px,4vw,52px);

    line-height:1.2;

    font-weight:900;
}

.modal-content p{
    color:#aeb3b5;

    font-size:15px;

    line-height:2;
}

.modal-meta{
    display:flex;

    gap:12px;

    flex-wrap:wrap;

    margin:25px 0;
}

.modal-pill{
    padding:7px 12px;

    border:1px solid var(--line);

    color:#ddd;

    font-size:11px;
}

.close{
    position:absolute;

    top:15px;
    left:15px;

    z-index:10;

    width:42px;
    height:42px;

    border:1px solid
        rgba(255,255,255,.20);

    background:rgba(0,0,0,.70);

    color:#fff;

    font-size:25px;

    cursor:pointer;

    transition:.3s;
}

.close:hover{
    background:var(--accent);

    color:#000;
}


/* =========================
   FOOTER
========================= */

footer{
    padding:50px 5%;

    text-align:center;

    background:#050606;

    border-top:
        1px solid
        rgba(255,255,255,.08);
}

footer img{
    height:48px;

    margin-bottom:14px;

    filter:
        brightness(0)
        invert(1);
}

footer p{
    color:#777;

    font-size:12px;
}


/* =========================
   RESPONSIVE
========================= */

@media(max-width:1100px){

    .production-grid{
        grid-template-columns:
            repeat(3,1fr);
    }

    .nav-links{
        gap:15px;

        font-size:13px;
    }

}


@media(max-width:760px){

    .navbar{
        height:70px;

        padding:0 18px;
    }

    .logo{
        height:44px;
    }

    .menu-btn{
        display:block;
    }

    .nav-links{
        position:absolute;

        top:70px;

        right:0;
        left:0;

        display:none;

        flex-direction:column;

        align-items:stretch;

        gap:0;

        padding:15px 22px 22px;

        background:#fff;

        box-shadow:
            0 20px 35px
            rgba(0,0,0,.18);
    }

    .nav-links.open{
        display:flex;
    }

    .nav-links a{
        padding:12px 0;

        border-bottom:
            1px solid
            rgba(0,0,0,.08);
    }

    .nav-links a::after{
        display:none;
    }

    .lang-btn{
        width:100%;

        margin-top:13px;
    }

    .hero{
        margin-top:70px;

        min-height:68vh;
    }

    .hero-content{
        padding:
            70px
            20px
            55px;
    }

    .hero h1{
        font-size:48px;

        letter-spacing:-1px;
    }

    .hero p{
        font-size:14px;
    }

    .hero-stats{
        gap:22px;
    }

    .hero-stat strong{
        font-size:27px;
    }

    .productions-section{
        padding:
            55px
            18px
            75px;
    }

    .section-head{
        flex-direction:column;

        align-items:flex-start;
    }

    .production-grid{
        grid-template-columns:
            repeat(2,1fr);

        gap:14px;
    }

    .card-body{
        padding:13px;
    }

    .card h3{
        font-size:16px;
    }

    .card-desc{
        font-size:11px;
    }

    .modal-box{
        grid-template-columns:1fr;

        max-height:94vh;

        overflow:auto;
    }

    .modal-img{
        height:55vh;

        min-height:0;
    }

    .modal-content{
        padding:28px;
    }

    .modal-content h2{
        font-size:32px;
    }

}


@media(max-width:430px){

    .production-grid{
        grid-template-columns:1fr;
    }

    .poster{
        aspect-ratio:2/2.9;
    }

    .hero h1{
        font-size:42px;
    }

    .hero{
        min-height:65vh;
    }

    .modal-img{
        height:48vh;
    }

}

</style>
</head>


